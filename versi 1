    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap');
        
        body {
            font-family: 'Nunito', sans-serif; 
            background-color: #f0fdf4;
        }

        .tab-content {
            display: none;
            animation: bounceInUp 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        .tab-content.active {
            display: block;
        }
        
        @keyframes bounceInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg) scale(1); }
            50% { transform: translateY(-20px) rotate(10deg) scale(1.1); }
            100% { transform: translateY(0px) rotate(0deg) scale(1); }
        }
        @keyframes float-reverse {
            0% { transform: translateY(0px) rotate(0deg) scale(1); }
            50% { transform: translateY(20px) rotate(-10deg) scale(1.1); }
            100% { transform: translateY(0px) rotate(0deg) scale(1); }
        }
        @keyframes pulse-soft {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }
        
        .animate-float { animation: float 6s ease-in-out infinite; }
        .animate-float-delayed { animation: float-reverse 7s ease-in-out infinite 2s; }
        .animate-float-fast { animation: float 4s ease-in-out infinite 1s; }
        .animate-pulse-soft { animation: pulse-soft 2s infinite ease-in-out; }

        /* CSS Tree Structure for Organization Chart */
        .org-chart * { transition: all 0.3s; }
        .org-chart ul {
            padding-top: 20px; position: relative;
            display: flex; justify-content: center;
        }
        .org-chart li {
            float: left; text-align: center;
            list-style-type: none;
            position: relative;
            padding: 20px 8px 0 8px;
        }
        .org-chart li::before, .org-chart li::after {
            content: ''; position: absolute; top: 0; right: 50%;
            border-top: 3px solid #84cc16;
            width: 50%; height: 20px;
        }
        .org-chart li::after {
            right: auto; left: 50%;
            border-left: 3px solid #84cc16;
        }
        .org-chart li:only-child::after, .org-chart li:only-child::before { display: none; }
        .org-chart li:only-child { padding-top: 0; }
        .org-chart li:first-child::before, .org-chart li:last-child::after { border: 0 none; }
        .org-chart li:last-child::before {
            border-right: 3px solid #84cc16;
            border-radius: 0 10px 0 0;
        }
        .org-chart li:first-child::after { border-radius: 10px 0 0 0; }
        .org-chart ul ul::before {
            content: ''; position: absolute; top: 0; left: 50%;
            border-left: 3px solid #84cc16;
            width: 0; height: 20px;
        }

        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body:not(.qr-print-mode) { background: white; }
            body:not(.qr-print-mode) #main-content { margin: 0 !important; padding: 0 !important; width: 100% !important; }
            body:not(.qr-print-mode) .shadow-sm, body:not(.qr-print-mode) .shadow-md, body:not(.qr-print-mode) .shadow-lg { box-shadow: none !important; border: 1px solid #e2e8f0; }
            
            body.qr-print-mode nav, body.qr-print-mode header, body.qr-print-mode main, body.qr-print-mode #toast-container, body.qr-print-mode .bg-floating-icons { display: none !important; }
            body.qr-print-mode { background: white; margin: 0; padding: 20px; }
            body.qr-print-mode #qr-print-container { 
                display: grid !important; 
                grid-template-columns: repeat(4, 1fr); 
                gap: 15px; 
                width: 100%; 
            }
        }

        #qr-print-container { display: none; }
        .qr-label { 
            border: 2px dashed #cbd5e1; 
            padding: 15px; 
            text-align: center; 
            border-radius: 8px; 
            page-break-inside: avoid;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        
        #toast-container {
            position: fixed; bottom: 20px; right: 20px; z-index: 9999;
        }

        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: #f0fdf4; border-radius: 5px; }
        ::-webkit-scrollbar-thumb { background: #a3e635; border-radius: 5px; border: 2px solid #f0fdf4; }
        ::-webkit-scrollbar-thumb:hover { background: #84cc16; }
    </style>
</head>
