        window.handleFormSubmit = async function(event) {
            event.preventDefault();
            
            const classSelect = document.getElementById('form-class');
            const kelas = classSelect.value;
            let tahun = 'Tahun 1';
            if (kelas.startsWith('2')) tahun = 'Tahun 2';
            else if (kelas.startsWith('3')) tahun = 'Tahun 3';
            else if (kelas.startsWith('4')) tahun = 'Tahun 4';
            else if (kelas.startsWith('5')) tahun = 'Tahun 5';
            else if (kelas.startsWith('6')) tahun = 'Tahun 6';
            else if (kelas.startsWith('PPKI') || ['Adn', 'Firdaus', 'Mawa', 'Rayyan'].includes(kelas)) tahun = 'PPKI';
            
            const nama = document.getElementById('form-name').value;
            const inputs = document.querySelectorAll('.book-input');
            const btn = document.getElementById('submit-btn');

            let booksToProcess = [];

            for (const input of inputs) {
                const bookNo = input.value.trim().toUpperCase();
                const subjek = input.getAttribute('data-subject');
                const oldVal = input.getAttribute('data-old-val');

                if (bookNo) {
                    if (!/^SPBT-\d{1,6}$/.test(bookNo)) {
                        window.showToast(`Format nombor buku tidak sah untuk subjek ${subjek}`, "error");
                        input.focus();
                        return;
                    }

                    let isDuplicate = false;
                    let duplicateInfo = "";

                    for (const checkTahun in window.databaseByYear) {
                        for (const existingBook in window.databaseByYear[checkTahun]) {
                            const existingData = window.databaseByYear[checkTahun][existingBook];
                            if (existingBook === bookNo && (existingData.nama !== nama || existingData.kelas !== kelas)) {
                                isDuplicate = true;
                                duplicateInfo = `${existingData.nama} (${existingData.kelas})`;
                                break;
                            }
                        }
                        if (isDuplicate) break;
                    }

                    if (isDuplicate) {
                        window.showToast(`Ralat! Buku ${bookNo} (${subjek}) telah diagihkan kepada ${duplicateInfo}. Sila guna nombor lain.`, "error");
                        input.focus();
                        return;
                    }

                    if (bookNo !== oldVal) {
                        booksToProcess.push({ action: 'update', bookNo, subjek, oldVal });
                    }
                } else if (oldVal && !bookNo) {
                    booksToProcess.push({ action: 'delete', bookNo: oldVal, subjek });
                }
            }

            if (booksToProcess.length === 0) {
                window.showToast('Tiada perubahan buku baru dikesan untuk disimpan.', 'error');
                return;
            }

            const oriBtnHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xl"></i> Sedang Menyimpan...';
            btn.disabled = true;
            window.showToast('Sedang menyimpan dan menyegerak data ke Awan...');

            const timestamp = new Date().toISOString();
            if (!window.databaseByYear[tahun]) window.databaseByYear[tahun] = {};

            for (const item of booksToProcess) {
                await new Promise(resolve => setTimeout(resolve, 500));

                if (item.action === 'delete') {
                    delete window.databaseByYear[tahun][item.oldVal];
                    if (GOOGLE_SHEET_API_URL) {
                        try {
                            await fetch(GOOGLE_SHEET_API_URL, {
                                method: 'POST',
                                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                                body: JSON.stringify({ action: 'delete', tahun: tahun, bookNo: item.oldVal })
                            });
                        } catch(e) { console.error(e); }
                    }
                } else if (item.action === 'update') {
                    if (item.oldVal && item.oldVal !== item.bookNo) {
                        delete window.databaseByYear[tahun][item.oldVal];
                        if(GOOGLE_SHEET_API_URL) {
                            try {
                                await fetch(GOOGLE_SHEET_API_URL, { method: 'POST', body: JSON.stringify({action: 'delete', tahun: tahun, bookNo: item.oldVal}) });
                            } catch(e) {}
                        }
                    }

                    window.databaseByYear[tahun][item.bookNo] = { nama: nama, kelas: kelas, title: item.subjek, masa: timestamp };
                    
                    if (GOOGLE_SHEET_API_URL) {
                        const payload = { action: 'update', tahun: tahun, bookNo: item.bookNo, oldBookNo: item.oldVal, nama: nama, kelas: kelas, subjek: item.subjek, masa: timestamp };
                        try {
                            await fetch(GOOGLE_SHEET_API_URL, {
                                method: 'POST',
                                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                                body: JSON.stringify(payload)
                            });
                        } catch(e) { console.error(e); }
                    }
                }
            }
            
            btn.disabled = false;
            updateUIAfterDataLoad();
            window.populateExistingBooks(); // Refresh UI dan butang akan terus menjadi oren (Kemaskini)
            
            window.showToast('Tahniah! Semua rekod berjaya dikemaskini.');
        }

