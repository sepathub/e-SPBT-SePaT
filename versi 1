                div.innerHTML = `
                    <div class="flex justify-between text-xs font-extrabold text-slate-500 mb-2 uppercase tracking-wide">
                        <span>${tahun}</span><span id="stat-${mapId}">${count} Buku (${pct}%)</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-3.5 shadow-inner overflow-hidden border border-slate-200/50">
                        <div class="bg-gradient-to-r ${color} h-full rounded-full transition-all duration-1000 relative" style="width: ${pct}%" id="bar-${mapId}">
                            <div class="absolute inset-0 bg-white/20" style="background-image: linear-gradient(45deg, rgba(255,255,255,0.15) 25%, transparent 25%, transparent 50%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0.15) 75%, transparent 75%, transparent); background-size: 1rem 1rem;"></div>
                        </div>
                    </div>
                `;
                container.appendChild(div);
            });
            
            const annContainer = document.getElementById('announcement-container');
            if (annContainer && window.dashboardData && window.dashboardData.pengumuman) {
                annContainer.innerHTML = '';
                const icons = ['fa-circle-info text-blue-400', 'fa-check-circle text-lime-500', 'fa-cloud-arrow-up text-emerald-500', 'fa-bell text-amber-500'];
                const bgs = ['bg-blue-50 text-blue-900 border-blue-100', 'bg-lime-50 text-emerald-900 border-lime-200', 'bg-emerald-50 text-emerald-900 border-emerald-200', 'bg-amber-50 text-amber-900 border-amber-200'];

                window.dashboardData.pengumuman.forEach((text, index) => {
                    const styleIdx = index % bgs.length;
                    annContainer.innerHTML += `
                        <div class="${bgs[styleIdx]} p-5 rounded-2xl text-sm font-bold border shadow-sm flex gap-4 transform transition-all hover:scale-[1.02]">
                            <i class="fa-solid ${icons[styleIdx]} text-2xl mt-0.5"></i> 
                            <p>${text}</p>
                        </div>
                    `;
                });
            }
        }
        
        window.renderPrintTable = function() {
            const tbody = document.getElementById('print-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';
            
            const selTahunEl = document.getElementById('filter-tahun');
            const selKelasEl = document.getElementById('filter-kelas');
            const selectedTahun = selTahunEl ? selTahunEl.value : 'Tahun 1';
            const selectedKelas = selKelasEl ? selKelasEl.value : 'Semua Kelas';
            const currentYearData = window.databaseByYear[selectedTahun] || {};
            
            let count = 1;
            const entries = Object.entries(currentYearData).sort((a,b) => (a[0] > b[0] ? 1 : -1));
            
            entries.forEach(([bookId, data]) => {
                if (selectedKelas !== 'Semua Kelas' && data.kelas !== selectedKelas) return;
                
                const dateStr = new Date(data.masa).toLocaleDateString('ms-MY', { day: 'numeric', month: 'short', year: 'numeric' });
                const qrUrl = encodeURIComponent(getQRUrl(bookId));
                
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-lime-50/50 transition-colors group';
                tr.innerHTML = `
                    <td class="px-6 py-5 text-center text-slate-400 font-bold">${count++}</td>
                    <td class="px-6 py-5 font-mono font-black text-emerald-900 text-base">${bookId}</td>
                    <td class="px-6 py-5 text-emerald-800 font-bold uppercase">${data.title}</td>
                    <td class="px-6 py-5">
                        <div class="font-black text-emerald-950 mb-1">${data.nama}</div>
                        <div class="text-[10px] text-slate-500 font-bold uppercase bg-slate-100 inline-block px-2 py-0.5 rounded">${data.kelas} • ${dateStr}</div>
                    </td>
                    <td class="px-6 py-5 text-center">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=45x45&data=${qrUrl}" class="inline-block rounded-lg shadow-sm border border-slate-200 opacity-90 group-hover:scale-125 transition-transform duration-300 cursor-pointer" onclick="window.openStudentModal('${bookId}', ${JSON.stringify(data).replace(/"/g, '&quot;')})" alt="QR">
                    </td>
                    <td class="px-6 py-5 text-center no-print">
                        <button onclick="window.openStudentModal('${bookId}', ${JSON.stringify(data).replace(/"/g, '&quot;')})" class="bg-white text-emerald-600 border-2 border-emerald-200 hover:bg-emerald-50 px-5 py-2 rounded-xl font-black text-xs transition-colors shadow-sm hover:shadow-md transform hover:-translate-y-0.5">Semak Nama</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            
            if (count === 1) {
                tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-10 text-center text-slate-400 font-black text-lg">Tiada rekod ditemui untuk saringan tab ${selectedTahun}.</td></tr>`;
            }
        }
        
        function renderSessionRecords() {
            const tbody = document.getElementById('session-records');
            if (!tbody) return;
            tbody.innerHTML = '';
            
            let allEntries = [];
            for (const tahun in window.databaseByYear) {
                for (const bookNo in window.databaseByYear[tahun]) {
                    allEntries.push({ bookNo, ...window.databaseByYear[tahun][bookNo] });
                }
            }
            
            const entries = allEntries
                .sort((a, b) => new Date(b.masa) - new Date(a.masa))
                .slice(0, 15); 
                
            if(entries.length === 0) {
                tbody.innerHTML = `<tr><td colspan="2" class="px-5 py-10 text-center text-emerald-600/50 font-bold text-sm">Tiada rekod dimasukkan.</td></tr>`;
                return;
            }
            
            entries.forEach((data) => {
                const time = new Date(data.masa).toLocaleTimeString('ms-MY', { hour: '2-digit', minute:'2-digit' });
                const tr = document.createElement('tr');
                tr.className = 'border-b-2 border-emerald-50/50 hover:bg-white/80 transition-colors font-semibold';
                tr.innerHTML = `
                    <td class="px-5 py-4 text-emerald-600/70 font-black text-xs bg-emerald-50/30">${time}</td>
                    <td class="px-5 py-4">
                        <div class="flex items-center gap-3">
                            <div class="font-mono font-black text-emerald-900 bg-lime-100 px-2 py-1 rounded-lg text-xs border border-lime-200">${data.bookNo}</div>
                            <div>
                                <div class="font-bold text-emerald-950">${data.nama}</div>
                                <div class="text-[10px] text-slate-500 font-bold uppercase">${data.title} • ${data.kelas}</div>
                            </div>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        const mobileBtn = document.getElementById('mobile-menu-btn');
        if (mobileBtn) {
            mobileBtn.addEventListener('click', () => {
                const menu = document.getElementById('mobile-menu');
                if (menu) menu.classList.toggle('hidden');
            });
        }

        const studentModalEl = document.getElementById('student-modal');
        if (studentModalEl) {
            studentModalEl.addEventListener('click', (e) => {
                if (e.target === studentModalEl) window.closeStudentModal();
            });
        }
        
        const previewModalEl = document.getElementById('print-preview-modal');
        if (previewModalEl) {
            previewModalEl.addEventListener('click', (e) => {
                if (e.target === previewModalEl) window.closePreviewModal();
            });
        }

        const roleModalEl = document.getElementById('role-modal');
        if (roleModalEl) {
            roleModalEl.addEventListener('click', (e) => {
                if (e.target === roleModalEl) window.closeRoleModal();
            });
        }

        window.addEventListener('DOMContentLoaded', () => {
            initDataLoad();
            window.renderNavByRole();
            
            const urlParams = new URLSearchParams(window.location.search);
            const semakId = urlParams.get('semak');
            
            if (semakId) {
                window.history.replaceState({}, document.title, window.location.pathname);
                setTimeout(() => {
                    let foundData = null;
                    for (const tahun in window.databaseByYear) {
                        if (window.databaseByYear[tahun][semakId]) {
                            foundData = window.databaseByYear[tahun][semakId];
                            break;
                        }
                    }
                    if(foundData) {
                        window.openStudentModal(semakId, foundData);
                        window.switchTab('semakan'); 
                    } else {
                        window.switchTab('semakan');
                        window.showToast(`Buku ${semakId} kosong / belum ditagging kepada murid.`, 'error');
                    }
                }, 1500);
            }
        });
    </script>
</body>
</html>
