        window.populateExistingBooks = function() {
            const classSelect = document.getElementById('form-class');
            const nameSelect = document.getElementById('form-name');
            const inputs = document.querySelectorAll('.book-input');
            const submitBtn = document.getElementById('submit-btn');

            inputs.forEach(input => {
                input.value = '';
                input.setAttribute('data-old-val', '');
                input.classList.remove('border-lime-500', 'bg-lime-100/50', 'text-lime-900');
                input.classList.add('border-emerald-100', 'bg-emerald-50/30');
            });

            const kelas = classSelect.value;
            const nama = nameSelect.value;
            if (!kelas || !nama) {
                resetSubmitButton(submitBtn);
                return;
            }

            let tahun = 'Tahun 1';
            if (kelas.startsWith('2')) tahun = 'Tahun 2';
            else if (kelas.startsWith('3')) tahun = 'Tahun 3';
            else if (kelas.startsWith('4')) tahun = 'Tahun 4';
            else if (kelas.startsWith('5')) tahun = 'Tahun 5';
            else if (kelas.startsWith('6')) tahun = 'Tahun 6';
            else if (kelas.startsWith('PPKI') || ['Adn', 'Firdaus', 'Mawa', 'Rayyan'].includes(kelas)) tahun = 'PPKI';

            const currentYearData = window.databaseByYear[tahun] || {};
            let hasExistingData = false;

            for (const bookNo in currentYearData) {
                const data = currentYearData[bookNo];
                if (data.nama === nama && data.kelas === kelas) {
                    const input = document.querySelector(`.book-input[data-subject="${data.title}"]`);
                    if (input) {
                        input.value = bookNo;
                        input.setAttribute('data-old-val', bookNo);
                        input.classList.remove('border-emerald-100', 'bg-emerald-50/30');
                        input.classList.add('border-lime-500', 'bg-lime-100/50', 'text-lime-900');
                        hasExistingData = true;
                    }
                }
            }
            
            if (hasExistingData) {
                submitBtn.innerHTML = '<i class="fa-solid fa-pen-to-square text-xl group-hover:scale-110 transition-transform"></i> Kemaskini Rekod Pengagihan';
                submitBtn.className = 'bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-10 py-4 rounded-2xl text-base font-black transition-all duration-300 shadow-[0_8px_20px_-5px_rgba(245,158,11,0.4)] hover:shadow-[0_12px_25px_-5px_rgba(245,158,11,0.5)] transform hover:-translate-y-1 flex items-center gap-3 w-full sm:w-auto justify-center group';
            } else {
                resetSubmitButton(submitBtn);
            }
        }
        
        function resetSubmitButton(btn) {
            if(!btn) return;
            btn.innerHTML = '<i class="fa-solid fa-floppy-disk text-xl group-hover:scale-110 transition-transform"></i> Simpan Rekod Pengagihan';
            btn.className = 'bg-gradient-to-r from-emerald-500 to-lime-500 hover:from-emerald-600 hover:to-lime-600 text-white px-10 py-4 rounded-2xl text-base font-black transition-all duration-300 shadow-[0_8px_20px_-5px_rgba(34,197,94,0.4)] hover:shadow-[0_12px_25px_-5px_rgba(34,197,94,0.5)] transform hover:-translate-y-1 flex items-center gap-3 w-full sm:w-auto justify-center group';
        }
        
