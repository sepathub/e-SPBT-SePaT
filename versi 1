        window.formatSPBTInput = function(input) {
            let val = input.value.toUpperCase().replace(/[^A-Z0-9-]/g, '');
            if (val.startsWith('SPBT')) {
                val = 'SPBT-' + val.substring(4).replace(/-/g, '');
            } else if (/^\d+$/.test(val)) {
                val = 'SPBT-' + val;
            } else if (val.length > 0 && !val.startsWith('SPBT-')) {
                val = 'SPBT-' + val.replace('SPBT', '').replace(/-/g, '');
            }
            if (val.length > 12) val = val.substring(0, 12);
            input.value = val;
        }

        window.startQRScanner = function() {
            const qrReader = document.getElementById('qr-reader');
            const qrPlaceholder = document.getElementById('qr-placeholder');
            const stopBtn = document.getElementById('stop-camera-btn');

            if (qrPlaceholder) qrPlaceholder.classList.add('hidden');
            if (qrReader) qrReader.classList.remove('hidden');
            if (stopBtn) stopBtn.classList.remove('hidden');

            window.html5QrCode = new Html5Qrcode("qr-reader");
            const config = { fps: 10, qrbox: { width: 250, height: 250 } };

            window.html5QrCode.start({ facingMode: "environment" }, config, 
                (decodedText) => {
                    window.stopQRScanner();
                    playBeepSound();
                    
                    let bookId = decodedText;
                    if (bookId.includes('?semak=')) {
                        bookId = bookId.split('?semak=')[1].split('&')[0];
                    }
                    
                    let found = false;
                    for (const tahun in window.databaseByYear) {
                        if (window.databaseByYear[tahun][bookId]) {
                            found = true;
                            window.openStudentModal(bookId, window.databaseByYear[tahun][bookId]);
                            break;
                        }
                    }
                    
                    if (found) {
                        window.showToast('Ceria! Kod berjaya diimbas.');
                    } else {
                        window.showToast(`Buku ${bookId} belum ditagging kepada mana-mana murid lagi.`, 'error');
                    }
                },
                () => {}
            ).catch((err) => {
                window.stopQRScanner();
                window.showToast('Gagal mengakses kamera peranti.', 'error');
            });
        }

        window.stopQRScanner = function() {
            if (window.html5QrCode) {
                window.html5QrCode.stop().then(() => {
                    window.html5QrCode.clear();
                    window.html5QrCode = null;
                }).catch(err => console.error(err));
            }
            const placeholderEl = document.getElementById('qr-placeholder');
            const readerEl = document.getElementById('qr-reader');
            const stopBtnEl = document.getElementById('stop-camera-btn');
            if(placeholderEl) placeholderEl.classList.remove('hidden');
            if(readerEl) readerEl.classList.add('hidden');
            if(stopBtnEl) stopBtnEl.classList.add('hidden');
        }

        function playBeepSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                osc.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.1);
            } catch(e) {}
        }

