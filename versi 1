            const selectedClass = classSelect.value;
            
            nameSelect.innerHTML = '<option value="" disabled selected>-- Pilih Nama Murid --</option>';
            
            if (selectedClass && window.senaraiMurid && window.senaraiMurid[selectedClass]) {
                const muridList = window.senaraiMurid[selectedClass];
                if (muridList.length > 0) {
                    muridList.sort().forEach(nama => {
                        const opt = document.createElement('option');
                        opt.value = nama;
                        opt.textContent = nama;
                        nameSelect.appendChild(opt);
                    });
                } else {
                    nameSelect.innerHTML = '<option value="" disabled selected>-- Tiada rekod di Google Sheet --</option>';
                }
            } else if (selectedClass) {
                nameSelect.innerHTML = '<option value="" disabled selected>-- Tiada rekod di Google Sheet --</option>';
            }
        }

        window.initDataLoad = async function(isSync = false) {
            const statusEl = document.getElementById('db-status');
            
            if (isSync && statusEl) {
                statusEl.innerHTML = '<i class="fa-solid fa-arrows-rotate fa-spin text-lime-300"></i> Menyegerak...';
            }

            if (!GOOGLE_SHEET_API_URL) {
                window.databaseByYear = {
                    'Tahun 1': {}, 'Tahun 2': {}, 
                    'Tahun 3': { 'SPBT-00001': { nama: 'Muhammad Adam Bin Rosli', kelas: '3 Aktif', title: 'Bahasa Melayu Jld 1', masa: new Date().toISOString() } },
                    'Tahun 4': {}, 'Tahun 5': {}, 'Tahun 6': {}, 'PPKI': {}
                };
                updateUIAfterDataLoad();
                if(statusEl) statusEl.innerHTML = '<i class="fa-solid fa-hard-drive text-amber-300"></i> Local Mock Mode';
                return;
            }

            try {
                const response = await fetch(GOOGLE_SHEET_API_URL);
                const data = await response.json();
                
                if (data.students) {
                    window.databaseByYear = data.students;
                    window.dashboardData = data.dashboard;
                    if(data.senaraiMurid) window.senaraiMurid = data.senaraiMurid;
                } else {
                    window.databaseByYear = data;
                }
                
                isDbReady = true;
                if(statusEl) statusEl.innerHTML = '<i class="fa-solid fa-cloud-arrow-down text-lime-300"></i> Awan Dikemaskini';
                
                updateUIAfterDataLoad();
                if (isSync) window.showToast('Data berjaya disegerakkan dengan Google Sheets!');
            } catch (error) {
                console.error("Gagal menyambung ke Google Sheets:", error);
                if(statusEl) statusEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-rose-300"></i> Ralat Sambungan Awan';
                window.showToast('Gagal memuat turun data dari Google Sheets.', 'error');
            }
        }

